# Tạo .env (chạy trong thư mục AI_Service/tts_service):
#   PowerShell:  Copy-Item -Path .env.example -Destination .env
#   CMD:         copy /Y .env.example .env

# Dùng viXTTS trong folder riêng (bỏ dòng này nếu chỉ dùng thư mục model mặc định)
# TTS_MODEL_DIR=model_vixtts

# Gộp chunk ngắn — khuyến nghị với capleaf/viXTTS (câu < ~10 từ dễ lỗi)
TTS_MIN_WORDS_PER_CHUNK=10

# Redis / worker (wordker.py) — điền giá trị thật, đừng để placeholder
# REDIS_HOST=localhost
# REDIS_PORT=6379
# EXTERNAL_HOST=127.0.0.1
# EXTERNAL_PORT=8123
# QUEUE_MAXSIZE=32
# STREAM_GET_TIMEOUT=120
# QUEUE_PUT_TIMEOUT=30
